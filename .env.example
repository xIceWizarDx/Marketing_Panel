APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Midia (ffprobe/ffmpeg) ------------------------------------------------
# NAO sao bibliotecas do projeto: sao programas do sistema, instalados a parte.
# Veja o README (secao "Dependencias do sistema") antes de rodar o modulo de midia.
# Windows: "C:/tools/ffmpeg/bin/ffprobe.exe"   Linux: /usr/bin/ffprobe
FFPROBE_CAMINHO=ffprobe
FFMPEG_CAMINHO=ffmpeg

# --- Google / YouTube -------------------------------------------------------
# Credenciais do projeto no Google Cloud (console.cloud.google.com).
# Escopos necessarios: youtube.upload + youtube.readonly
# O redirecionamento precisa estar cadastrado igualzinho no console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/conexoes/youtube/retorno"
# Tela de permissao do Google ainda em "Testes"? Nesse modo o Google encerra
# a autorizacao a cada 7 dias — a mensagem ao usuario muda por causa disto.
GOOGLE_EM_TESTES=true

# Facebook + Instagram — uma credencial so acende as duas redes.
# Crie o aplicativo em https://developers.facebook.com/apps (tipo Empresa).
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI="${APP_URL}/conexoes/meta/retorno"
# A configuracao do Login para Empresas. Sem ela a Meta concede as permissoes
# e NAO anexa Pagina nenhuma — e responde "deu certo" em todas as telas (DEC-162).
META_CONFIG_ID=

# LinkedIn — aplicativo PROPRIO, no portal da LinkedIn (nada a ver com a Meta).
# Produtos self-serve a adicionar no app: "Sign In with LinkedIn using OpenID
# Connect" e "Share on LinkedIn". Nenhum dos dois passa por analise.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/conexoes/linkedin/retorno"
# A versao datada do cabecalho `LinkedIn-Version`. ENVELHECE: versao aposentada
# derruba a publicacao inteira, e por isso ela mora aqui, trocavel sem deploy.
LINKEDIN_VERSAO=202607

# TikTok — no portal `developers.tiktok.com`. Produtos: Login Kit + Content
# Posting API (Direct Post). Escopos: user.info.basic, video.publish.
# ATENCAO: e `client_key`, nao `client_id`.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI="${APP_URL}/conexoes/tiktok/retorno"
# Enquanto a auditoria do TikTok nao sair, TODO post e privado e NAO existe
# link de prova. Virar `true` so depois que eles aprovarem.
TIKTOK_AUDITADO=false

# X — no console `console.x.com`. OAuth 2.0 com PKCE. Escopos:
# tweet.read tweet.write users.read media.write offline.access
# ATENCAO: publicar aqui CUSTA. US$ 0,015 por post, e US$ 0,200 se a legenda
# tiver link. Nao ha faixa gratuita; creditos sao comprados antes.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI="${APP_URL}/conexoes/x/retorno"

# Pinterest — publica em QUADRO, nao em perfil: conectar traz um canal por
# quadro. Escopos: boards:read pins:read pins:write user_accounts:read
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI="${APP_URL}/conexoes/pinterest/retorno"
